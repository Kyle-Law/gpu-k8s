# Copy to config.env to override defaults (or pass them as environment variables).
# Every line is optional; defaults live in lib/common.sh and depend on the detected GPU.

#STACK=llmd                    # llmd | llmd-multi | ollama | none  (set llmd-multi here so tools/ agree)
#GPU_PROFILE=modern            # force: legacy (V100-class, cc < 7.5) | modern
#MODEL=Qwen/Qwen3-8B           # llm-d / vLLM model   (legacy default: Qwen/Qwen3-0.6B)
#OLLAMA_MODEL=qwen3:8b         # Ollama model         (legacy default: qwen2.5:0.5b)
#MAX_MODEL_LEN=8192            # context length       (legacy default: 4096)
#GPU_MEM_UTIL=0.90             # fraction of VRAM vLLM may reserve
#MULTIGPU_MODE=tp              # llmd-multi only: tp (one replica over all GPUs) | replicas (one per GPU)
#TP_SIZE=                      # GPUs per replica   (tp: all GPUs; replicas: 1)
#REPLICAS=                     # vLLM replicas      (tp: 1; replicas: all GPUs)
#VLLM_IMAGE=                   # empty = llm-d's own image (modern); legacy pins vllm/vllm-openai:v0.8.5.post1
#VLLM_EXTRA_ARGS=              # extra vLLM flags, space separated
#HF_TOKEN=                     # only for gated models; wrong tokens cause 401s
#MS_CPU_REQ=2                  # model server pod requests / limits
#MS_MEM_REQ=6Gi
#MS_MEM_LIM=24Gi
#NAMESPACE=llm-d-quickstart
#LLMD_BRANCH=release-1.0
#LLMD_DIR=$HOME/llm-d
#OBSERVABILITY=1               # 1 = install Prometheus + Grafana + DCGM (same as ./setup.sh --observability)
#MONITORING_NS=monitoring
#KPS_CHART_VERSION=            # kube-prometheus-stack chart version (empty = latest)
#DCGM_CHART_VERSION=           # dcgm-exporter chart version (empty = latest)
#GATEWAY=1                     # 1 = Gateway API + Traefik in front of the model (same as ./setup.sh --gateway)
#GATEWAY_USER=llm              # basic-auth user; the password is generated (see tools/gateway.sh)
#GATEWAY_API_VERSION=v1.6.3    # standard-channel CRDs (what Traefik 3.7 documents support for)
#PUBLIC_HOST=                  # address users browse to (empty = Traefik's external IP); set a DNS name if you have one
